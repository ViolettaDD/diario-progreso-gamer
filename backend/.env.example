# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.

# Cadena de conexión de MongoDB Atlas (usuario y contraseña del usuario de base de datos)
MONGODB_URI=

# Nombre de la base de datos del proyecto (ejemplo)
MONGODB_DB=diario_gamer

# Puerto local. En Render no se define: Render asigna el suyo.
PORT=3000

# Orígenes permitidos por CORS, separados por coma (URL pública del frontend en Render, sin "/" final).
# Vacío = se aceptan todos los orígenes (solo para desarrollo local).
CORS_ORIGIN=

# Solo en local: "true" habilita GET /api/debug/error para comprobar el manejo del error 500.
PERMITIR_ERROR_PRUEBA=false
